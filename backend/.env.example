# ──────────────────────────────────────────────────────────────────────────────
# PRODUCTION ENVIRONMENT TEMPLATE
# Set ALL of these in your hosting dashboard (Render / Railway / etc.)
# DO NOT put real secrets in this file — it is safe to commit.
# ──────────────────────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────────────────────
# Generate a strong key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_KEY

# MUST be False in production — any other value is a security risk
DEBUG=False

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:port/dbname

# ── Hosts & Origins ───────────────────────────────────────────────────────────
# Comma-separated, no spaces, no trailing slashes
# Include your Render/Railway internal hostname too
ALLOWED_HOSTS=urbanixsolution.com,www.urbanixsolution.com,your-app.onrender.com

# Comma-separated list of your live Next.js frontend origins (https://)
CORS_ALLOWED_ORIGINS=https://urbanixsolution.com,https://www.urbanixsolution.com

# Must include your API host AND your frontend host (so CSRF cookies work)
CSRF_TRUSTED_ORIGINS=https://urbanixsolution.com,https://www.urbanixsolution.com,https://your-api.onrender.com

# ── HTTPS / HSTS ──────────────────────────────────────────────────────────────
# Set SECURE_SSL_REDIRECT=True ONLY after confirming HTTPS works end-to-end.
# Set SECURE_HSTS_SECONDS=31536000 ONLY after confirming SSL_REDIRECT works.
# Wrong HSTS values are very difficult to undo (browsers cache them for a year).
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ── reCAPTCHA ─────────────────────────────────────────────────────────────────
RECAPTCHA_SECRET_KEY=your_production_recaptcha_secret_key

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://your-redis-host:6379/0
